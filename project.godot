;   param=value ; assign values to parameters

config_version=5

[application]

config/name="console"
run/main_scene="uid://desn55d31jhik"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")

[autoload]

ControllerSocket="*res://global/ControllerSocket.cs"
SceneSwitcher="*res://global/SceneSwitcher.cs"

[display]

window/size/viewport_width=720
window/size/viewport_height=720
window/size/window_width_override=720
window/size/window_height_override=720

[dotnet]

project/assembly_name="console"

